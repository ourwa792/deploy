      <script>
        //import { JSXGraph } from 'https://cdn.jsdelivr.net/npm/jsxgraph/distrib/jsxgraphcore.mjs';

        window.addEventListener("DOMContentLoaded", () => {

          const board = JXG.JSXGraph.initBoard('jxgbox', {
            boundingbox: [-1, 10, 10, -1],
            axis: true
          });

          // البيانات الافتراضية للمخطط
          let dataValues = [8, 1, 3, 4, 2];
          let chart = createChart(dataValues); // إنشاء المخطط لأول مرة

          // دالة لإنشاء المخطط
          function createChart(data) {
            return board.create('chart', [data], {
              chartStyle: 'bar',
              width: .88,
              colorArray: ['#8E1B77', '#BE1679', '#DC1765', '#DA2130', '#DB311B'],
              labels: ["اللغة العربية", "الموسيقا", "العلوم", "الرياضيات", "الرياضة"],
              label: { fontSize: 16, display: 'internal' }
            });
          }

          // وظيفة لتحديث المخطط
          function updateChart(newData) {
            board.removeObject(chart); // حذف المخطط الحالي
            chart = createChart(newData); // إنشاء المخطط من جديد مع البيانات الجديدة
            board.update();
          }

          // عناصر الإدخال لتحديث البيانات
          dataValues.forEach((value, index) => {
            const input = document.createElement('input');
            input.type = 'number';
            input.value = value;
            input.addEventListener('change', (e) => {
              dataValues[index] = parseFloat(e.target.value);
              updateChart(dataValues);
            });
            document.getElementById('inputs').appendChild(input);
          });


          createSelect({
            questions_html: '.questions_3_1',
            check_button: '#check_answers_3_1',
            reset_button: '#reset_answers_3_1',
            answer_button: '#answers_3_1',
            answers: [2, 1, 3]
          });


          createSelect({
            questions_html: '.questions_1',
            check_button: '#check_answers_1',
            reset_button: '#reset_answers_1',
            answer_button: '#answers_1',
            answers: [1, 2]
          });

          setTimeout(() => {

            var typed = new Typed('#element', {
              strings: ["سنقوم بتمثيل عدد الواجبات التالية بيانياً"],
              typeSpeed: 30,
              loop: false
            });
          }, 2000)

          // board -2-
          var board1 = JXG.JSXGraph.initBoard('jxgbox2', { boundingbox: [-0.5, 8, 9, -2], axis: true });
          var chart1;

          document.addEventListener("click", function updateChart1() {
            var dataInput = document.getElementById('dataInput').value;
            //var chartType = document.getElementById('chartType').value;
            var dataArr = dataInput.split(',').map(function (item) {
              return parseFloat(item);
            });

            if (chart1) {
              board1.removeObject(chart1);

            }

            var chartOptions = {
              chartStyle: "bar",
              width: 0.8,
              labels: dataArr,
              colorArray: ['#8E1B77', '#BE1679', '#DC1765', '#DA2130', '#DB311B', '#DF4917', '#E36317', '#E87F1A', '#F1B112', '#FCF302', '#C1E212'],
              label: { fontSize: 16, display: 'internal', anchorX: 'left', rotate: 90 }
            };

           /*  if (chartType === 'pie') {
              chartOptions.center = [5, 2];
              chartOptions.fillOpacity = 0.9;
              chartOptions.strokeColor = '#ffffff';
              chartOptions.strokeWidth = 6;
              chartOptions.highlightBySize = true;
              chartOptions.highlightOnSector = true;
            } */

            chart1 = board1.create('chart', dataArr, chartOptions);
          })
          
          /* 
          const buttons = document.querySelectorAll("button"); // تحديد جميع الأزرار
          buttons.forEach(btn => {
              const audio = new Audio(btn.getAttribute("data-sound"));
              btn.addEventListener("click", e => {
                  if (!audio.playing) {
                      audio.play();
                      btn.disabled = true;  // تعطيل الزر أثناء تشغيل الصوت

                      audio.onended = () => {
                          btn.disabled = false;
                      };
                  }
              });

              Object.defineProperty(audio, 'playing', {
                  get: function () {
                      return !this.paused && !this.ended;
                  }
              });
          }); */

        })
      </script>

