    if (pages.page === page6) {
        pen.paper = drawContainer6; // تعيين حاوية الصفحة 6 كـ paper
        pen.write = true; // السماح بالرسم على الصفحة 6
    } else {
        pen.write = false; // تعطيل الرسم عند الانتقال لصفحات أخرى
    }
});


     loop(pages.pages, function (page) {
                 page.page.icon.tap(function () {
                zgo("https://zimjs.com", "_blank");
                });
            });
 */

            stage.update()

        })
    </script>

</body>

</html>