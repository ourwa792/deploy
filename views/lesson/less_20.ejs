            <script >
             window.addEventListener("DOMContentLoaded", () => {
                // إعداد لوحة JSXGraph الأولى
                var board = JXG.JSXGraph.initBoard("jxgbox", {
                  boundingbox: [-10, 10, 10, -10],
                  axis: true,
                });
              
                // تقسيم المستوي إلى أربعة أرباع بألوان مختلفة
                board.create(
                  "polygon",
                  [
                    [0, 0],
                    [10, 0],
                    [10, 10],
                    [0, 10],
                  ],
                  { fillColor: "#f0c4c4", highlight: false }
                ); // الربع الأول
                board.create(
                  "polygon",
                  [
                    [0, 0],
                    [-10, 0],
                    [-10, 10],
                    [0, 10],
                  ],
                  { fillColor: "#c4e3f0", highlight: false }
                ); // الربع الثاني
                board.create(
                  "polygon",
                  [
                    [0, 0],
                    [-10, 0],
                    [-10, -10],
                    [0, -10],
                  ],
                  { fillColor: "#d1f0c4", highlight: false }
                ); // الربع الثالث
                board.create(
                  "polygon",
                  [
                    [0, 0],
                    [10, 0],
                    [10, -10],
                    [0, -10],
                  ],
                  { fillColor: "#f0e4c4", highlight: false }
                ); // الربع الرابع
              
                var infoText = board.create(
                  "text",
                  [-9, -9, "انقر على اللوحة لتحديد نقطة."],
                  {
                    fontSize: 20,
                    anchorX: "left",
                    color: "black",
                  }
                );
              
                board.create("text", [8, 6, "الربع الأول"], {
                  fontSize: 16,
                  anchorX: "center",
                  color: "orange",
                });
                board.create("text", [-9, 9, "الربع الثاني"], {
                  fontSize: 16,
                  anchorX: "center",
                  color: "green",
                });
                board.create("text", [-9, -6, "الربع الثالث"], {
                  fontSize: 16,
                  anchorX: "center",
                  color: "gold",
                });
                board.create("text", [8, -6, "الربع الرابع"], {
                  fontSize: 16,
                  anchorX: "center",
                  color: "red",
                });
              
                const successSound = new Audio("/sound/rightanswer.mp3");
                const challenges = [
                  { description: "حدد نقطة في الربع الأول", check: (x, y) => x > 0 && y > 0 },
                  {
                    description: "حدد نقطة في الربع الثاني",
                    check: (x, y) => x < 0 && y > 0,
                  },
                  {
                    description: "حدد نقطة في الربع الثالث",
                    check: (x, y) => x < 0 && y < 0,
                  },
                  {
                    description: "حدد نقطة في الربع الرابع",
                    check: (x, y) => x > 0 && y < 0,
                  },
                ];
              
                let currentChallenge = 0;
              
                board.on("down", function (e) {
                  if (currentChallenge >= challenges.length) {
                    infoText.setText("تهانينا! لقد أكملت جميع التحديات.");
                    successSound.play();
                    return;
                  }
              
                  var coords = board.getCoordsTopLeftCorner(e),
                    absPos = JXG.getPosition(e),
                    dx = absPos[0] - coords[0],
                    dy = absPos[1] - coords[1],
                    boardCoords = new JXG.Coords(JXG.COORDS_BY_SCREEN, [dx, dy], board);
              
                  var x = parseFloat(boardCoords.usrCoords[1].toFixed(2));
                  var y = parseFloat(boardCoords.usrCoords[2].toFixed(2));
              
                  board.create("point", [x, y], {
                    name: "(" + x + ", " + y + ")",
                    size: 4,
                    color: "blue",
                  });
              
                  const challenge = challenges[currentChallenge];
                  if (challenge.check(x, y)) {
                    infoText.setText(
                      `الإحداثيات: (${x}, ${y}) <br> ممتاز! ${challenge.description} تم تحقيقه.`
                    );
                    successSound.play();
              
                    currentChallenge++;
                    if (currentChallenge < challenges.length) {
                      infoText.setText(challenges[currentChallenge].description);
                    }
                  } else {
                    infoText.setText(
                      `الإحداثيات: (${x}, ${y}) <br> حاول مرة أخرى في: ${challenge.description}.`
                    );
                  }
                });
              
                // إعداد اللوحة الثانية خارج حدث 'down' للوحة الأولى
                var board1 = JXG.JSXGraph.initBoard("jxgbox2", {
                  boundingbox: [-10, 10, 10, -10],
                  axis: true,
                });
              
                var feedbackText = board1.create("text", [-9, -9, "حدد النقطة عند (3, 2)"], {
                  fontSize: 18,
                  anchorX: "left",
                  color: "black",
                });
              
                const targetPoints = [
                  { x: 2, y: 3, description: "حدد النقطة عند (3, 2)" },
                  { x: -2, y: 3, description: "حدد النقطة عند (3, 2-)" },
                  { x: 0, y: -3, description: "(0, -3)" },
                  { x: -1, y: -2, description: "(-1, -2)" },
                  { x: -2, y: -1, description: "(-2, -1)" },
                ];
              
                let currentTargetIndex = 0;
              
                function checkPoint(x, y) {
                  const target = targetPoints[currentTargetIndex];
                  const tolerance = 0.7;
              
                  if (
                    Math.abs(x - target.x) <= tolerance &&
                    Math.abs(y - target.y) <= tolerance
                  ) {
                    feedbackText.setText(
                      `ممتاز! تم تحديد النقطة (${target.x}, ${target.y}) بنجاح.`
                    );
                    successSound
                      .play()
                      .catch((error) => console.error("تعذر تشغيل الصوت:", error));
              
                    currentTargetIndex++;
                    if (currentTargetIndex < targetPoints.length) {
                      feedbackText.setText(targetPoints[currentTargetIndex].description);
                    } else {
                      feedbackText.setText("تهانينا! لقد أكملت جميع التحديات.", {
                        fontSize: 20,
                        color: "green"
                      });
                    }
                  } else {
                    feedbackText.setText(
                      `حاول مرة أخرى! النقطة ليست بالقرب من (${target.x}, ${target.y}).`
                    , {fontSize:20, color: "red"});
                  }
                }
              
                board1.on("down", function (e) {
                  var coords = board1.getCoordsTopLeftCorner(e),
                    absPos = JXG.getPosition(e),
                    dx = absPos[0] - coords[0],
                    dy = absPos[1] - coords[1],
                    boardCoords = new JXG.Coords(JXG.COORDS_BY_SCREEN, [dx, dy], board1);
              
                  var x = parseFloat(boardCoords.usrCoords[1].toFixed(2));
                  var y = parseFloat(boardCoords.usrCoords[2].toFixed(2));
              
                  board1.create("point", [x, y], {
                    name: "(" + x + ", " + y + ")",
                    size: 4,
                    color: "green",
                  });
              
                  checkPoint(x, y);
                });
              
                //           //
                createSelect({
                  questions_html: ".questions_2",
                  check_button: "#check_answers_2",
                  reset_button: "#reset_answers_2",
                  answer_button: "#answers_2",
                  answers: [1, 1, 3, 2, 2],
                });
              
                const buttons = document.querySelectorAll("button"); // تحديد جميع الأزرار
              
                buttons.forEach((btn) => {
                  // إنشاء صوت خاص لكل زر بناءً على الـ data-sound الخاص به
                  const audio = new Audio(btn.getAttribute("data-sound"));
              
                  btn.addEventListener("click", (e) => {
                    if (!audio.playing) {
                      audio.play();
                      btn.disabled = true; // تعطيل الزر أثناء تشغيل الصوت
              
                      audio.onended = () => {
                        btn.disabled = false;
                      };
                    }
                  });
              
                  Object.defineProperty(audio, "playing", {
                    get: function () {
                      return !this.paused && !this.ended;
                    },
                  });
                });
              });
               </script>


            <div class="row">
                <div class="col-1">
                    <a href="/" class="btn btn-outline-info mt-5">
                        <img src="/icon/iconBack.png" class="" width="34" height="34">
                        <span>الصفحة الرئيسية</span>

                    </a>

                </div>
            </div>

