<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> <%- lesson.title %> </title>

    <!--     
    <script src="/library/createjs.js"></script>
    <script src="/library/zim_min.js"></script>
    <script type="module" src="/library/zim_physics.js"></script>
     -->
    <script src="https://zimjs.org/cdn/Box2dWeb-2.1.a.3.min.js"></script>

    <!-- 
        <script type="module" src="https://zimjs.org/cdn/017/zim_physics.js"></script>
     -->
</head>

<body style="margin: 0; padding: 0" dir="auto">

    <script type="module">

        import zim from "https://zimjs.org/cdn/017/zim_physics.js";

        const scaling = FIT;
        const width = 1240;
        const height = 868;

        const assets = ["less-18.png", "shopcart.png", "crayongreen.png", "glasses07.png",
            "jewel07.png", "office20.png", "office18.png", "playsoccer.png", "playbear.png",
            "shop.jpg", "bg.jpg", "shafe.png","spongebob.png", "100_Pounds.jpg", "1000_Pounds.jpg",
            "sponge2.png" ,"less-4.png", "less-4-tamreen1.png", "less-4-tamreen2.png", "less_4.mp3"
            ,"coin-touch.wav", "coin-win.wav", "wronganswer.mp3"
        ];
        const path = "/assets/";

        var frame = new Frame({
            scaling,
            width, height,
            color: light,
            outerColor: light,
            allowDefault: true,
            assets,
            path,
            progress: new Waiter({ backgroundColor: blue, corner: 10 }),
        });

        frame.on("ready", function ready() {
            var stage = frame.stage;
            let stageW = frame.width;
            let stageH = frame.height;

            let dev_url = 'http://localhost:3000';
            let prod_url = 'https://deploy-kewv.onrender.com';

            const coinSound = new Aud({
                file: "/sound/coin-touch.wav", volume: 1.2, loop: false,
                maxNum: 1, interrupt: "any"
            });
            const coinWin = new Aud({
                file: "/sound/coin-win.wav", volume: 1, loop: false,
                maxNum: 1, interrupt: "any"
            });
            const wrongSound = new Aud({file: "/sound/wronganswer.mp3", volume: .8, loop: false,
                                maxNum: 1,          // يسمح بتشغيل نسخة واحدة من الصوت فقط
                                interrupt: "any"    // يقطع الصوت الحالي ويبدأ من جديد إذا تم النقر عليه مرة أخرى
                            })

            const emitter = new Emitter({
                obj: new Poly([30, 50, 80], 5, .5, [yellow, silver, grey, red]),
                gravity: 0,
                force: { min: 3, max: 6 },
                startPaused: true
            })

            // A Pen used on two different Pages with ZIM Pages
            const page1 = new Page(stageW, stageH, orange, red);
            //page1.paper = new Container(stageW, stageH).addTo(page1);
            const page3 = new Page(stageW, stageH, pink, purple);
            //page2.paper = new Container(stageW, stageH).addTo(page2);
            const page2 = new Page(stageW, stageH, yellow, white);

            const page4 = new Page(stageW, stageH, "aqua", green)

            const pages = new Pages([page1, page2, page3, page4]).addTo();
            //pages.active = false; // so drawing does not accidentally swipe pages


            // page -1-

           asset("bg.jpg").sca(.25).center(page1)
            
            const shafe = new Sprite({
                image:"shafe.png",
                rows: 2,
                cols: 6,
                offsetX: 0,
                animations:{mid:[1,5]} 
            }).run({loop:true, time:2, label:"mid"}).pos(300,500).addTo(page1)

            new Sprite({
                image:"spongebob.png",rows:1, cols:7
            }).run({loop:true, time:2}).pos(800,550).addTo(page1).sca(1.6)
           
            asset("less-4.png").pos(450,300).sca(.6).addTo(page1)

            const text = new Dialog({
                width: 260,
                height: 150,
                words: ["مرحبا يا أطفال", "أنا شفيق", "أنا متحمس لدرس العدد 1000" ],
                dialogType: "oval",
                borderWidth: 3,
                size: 40,
                font: "Comic Sans MS",
                color: dark,
                corner: 70,
                tailH: RIGHT,
                tailV: BOTTOM
            }).loc(170, 300, page1)  

            text.clone().pos(650,350).addTo(page1).setWords(["و أنا سبونج بوب","ومتحمس أيضاً"])
          

            // page -2-

            const sponge2 = new Sprite({
                image:"sponge2.png",rows:1, cols:3, count:100
            }).run({loop:true, time:.92}).pos(800,550).addTo(page2).sca(1.6);

            text.clone().pos(650,350).addTo(page2).setWords(["يتكون العدد ألف من 10 مئات قم بعدِّها"])

            for (let index = 1; index < 10; index++) {
                asset("100_Pounds.jpg").clone().pos(100 + index*70, 100).addTo(page2).sca(.9).drag().cur()     
            }

            asset("1000_Pounds.jpg").pos(240,400).addTo(page2).cur().on("mousedown", function(){
                new Aud({ file: "/sound/less_4.mp3", volume: 1.1, loop: false }).play();       
            })

            // page -3-
    
            asset("shop.jpg").sca(1.2).center(page3)
            const physics = new Physics({
                gravity: 10,
            })

            
            const basket = new Pic("shopcart.png") // ضع اسم الملف المناسب لصورة السلة
                .reg(CENTER)
                .sca(0.5) // تكبير وتصغير صورة السلة حسب الحجم المطلوب
                .pos(120, 475, RIGHT, UP)
                .addTo(page3)
                .addPhysics({ dynamic: false }) // جسم ثابت بدون حركة

            // قائمة الأغراض باستخدام الصور
            const items = [
                { name: "قلم", price: 200, image: "crayongreen.png", shape: "rectangle", sca: .18, label:160 },
                { name: "ممحاة ", price: 100, image: "office18.png", shape: "rectangle", sca: 1.1, label:20 },
                { name: "قلم", price: 200, image: "office20.png", shape: "rectangle", sca: 1.6, label:20 },
                { name: "كرة", price: 300, image: "playsoccer.png", shape: "circle", sca:1.4, label: 35 },
                { name: "مجوهرات", price: 800, image: "jewel07.png", shape: "triangle", sca:.13, label:290 },
                { name: "نظارة", price: 500, image: "glasses07.png", shape: "rectangle", sca:.85, label:40 },
                { name: "دمية", price: 600, image: "playbear.png", shape: "triangle", sca:.25, label:140 }
            ];

            const dial = new Dialog({
                width: 260,
                height: 150,
                dialogType: "oval",
                borderWidth: 3,
                size: 40,
                font: "Comic Sans MS",
                color: dark,
                corner: 70,
                tailH: RIGHT,
                tailV: BOTTOM
            })
            .pos(340,160).addTo(page3).setWords("هل يمكنك الشراء بمبلغ 1000 ليرة بالضبط؟")

            // إعداد المتغيرات لتتبع مجموع السعر الحالي والهدف
            let currentTotal = 0;
            const targetTotal = 1000;

            // عرض المجموع الحالي
            const totalLabel = new Label({
                text: `المجموع الحالي: ${currentTotal} ليرة`,
                align: CENTER,
                size:47,
                backgroundBorderColor:blue,
                backgroundBorderWidth:4,
                color:pink,
                rollColor:"gold",
                bold:true,
                italic:true
            }).pos(150, 50).addTo(page3);

            // إنشاء الأغراض باستخدام `Bitmap` مع الفيزياء
            items.forEach((item, index) => {
                const itemBitmap = new Pic(item.image) 
                    .sca(item.sca) 
                    .reg(CENTER)
                    .pos(80 + index * 100, 150) // توزيع الصور
                    .addPhysics({
                        shape: `${item.shape}`,
                        friction: 0.3,
                        bounciness: 0.5
                    })
                    .addTo(page3).cur();
                physics.drag([item])
                // عرض اسم وسعر الغرض فوق كل صورة
                const itemLabel = new Label({
                    text: `${item.name}\n${item.price} \n ليرة`,
                    color: "black",
                    size: `${item.label}`
                }).centerReg(itemBitmap);

                // التحقق من الاصطدام مع السلة
                itemBitmap.contact((obj) => {
                    if (obj === basket) {
                        currentTotal += item.price; // تحديث المجموع
                        coinSound.play();
                        totalLabel.text = `المجموع الحالي: ${currentTotal} ليرة`;
                        itemBitmap.removeFrom(); // إزالة الغرض بعد وضعه في السلة

                        // التحقق من المجموع النهائي
                        if (currentTotal === targetTotal) {
                          coinWin.play()
                          emitter.spurt(40).center(page3)
                          dial.setWords( "أحسنت لقد كونت 1000 ليرة بالضبط")
                          dial.color = green;

                        } else if (currentTotal > targetTotal) {
                            dial.setWords("لقد تجاوزت 1000 ليرة! ");
                            wrongSound.play();
                            dial.color = red
                        }
                    }
                });
            });

            // page - 4 -

            new asset("less-4-tamreen1.png").pos(90,160).addTo(page4).sca(.9)
            new asset("less-4-tamreen2.png").pos(190,290).addTo(page4).sca(.9)

             // الإجابات الصحيحة
             const correctAnswers = ["1000", "1000", "1000"]; // يمكنك إضافة أي عدد من الإجابات هنا

            // مصفوفة لتخزين حقول الإجابة (Labels)
            const answerFields = [];

            // إنشاء حقول الإجابة ديناميكيًا وإضافتها للصفحة
            correctAnswers.forEach((answer, index) => {
                const answerLabel = new Label({
                    text: "",
                    backgroundColor: "white",
                    size: 30,
                }).pos(810, 330 + index * 200).addTo(page4); // تعديل الموضع عموديًا لكل حقل
                answerFields.push(answerLabel); // إضافة الحقل للمصفوفة
            });

            // إعداد لوحة المفاتيح وتوصيلها بحقول الإجابة
            const keyboard = new Keyboard({
                labels: answerFields,
                backgroundColor: "lightgray",
                color: "black",
                draggable: true,
            }).addTo(page4)//.scaleTo(page4, 95, 25);

            // إظهار لوحة المفاتيح عند النقر على أي حقل إجابة
            answerFields.forEach((answerField, index) => {
                answerField.on("mousedown", () => keyboard.show(index)); // يظهر المؤشر في الحقل المحدد
            });

            // زر للتحقق من الإجابات
            const checkButton = new Button({
                label: "تحقق من الإجابات",
                width: 230,
                height: 60,
                backgroundColor: green,
                rollBackgroundColor: "darkblue",
                color: "white"
            }).pos(910,170).addTo(page4);

            checkButton.on("click", () => {
                // التحقق من الإجابة في كل حقل
                answerFields.forEach((label, index) => {

                    const userAnswer = label.text.trim();
                    if (userAnswer === correctAnswers[index]) {
                        label.text = "";
                        label.color = "green"; // إظهار الإجابة الصحيحة باللون الأخضر
                        label.text = "✅ " + userAnswer; // إضافة إشارة صح للإجابة الصحيحة
                        
                    } else {
                        label.text = "";
                        wrongSound.play()    
                        label.color = "red"; // إظهار الإجابة غير الصحيحة باللون الأحمر
                        label.text = "❌ " + userAnswer; // إضافة إشارة خطأ للإجابة الخاطئة
                    }
                });
            });

            // إعادة ضبط الإجابة عند النقر على الحقل مرة أخرى
            answerFields.forEach(label => {
                label.on("mousedown", () => {
                    label.color = "black"; // إعادة اللون إلى الأسود
                    label.text = ""; // مسح النص السابق
                });
            });

            // إضافة سجل عند إغلاق لوحة المفاتيح
            keyboard.on("close", () => {
                console.log("إغلاق لوحة المفاتيح:");
            });


            new Button({
                label: "الصفحة الرئيسية",
                width: 220,
                height: 60,
                backgroundColor: "purple",
                rollBackgroundColor: "MediumOrchid",
                borderWidth: 8,
                borderColor: "violet",
                gradient: .3,
                corner: 10
            }).pos(60, 100).addTo(page4)
            .tap(() => zgo(`${dev_url}`, "_blank"))



            new Label({
                text: "عدّ بالمئات ثم اكتب العدد المناسب",
                align: RIGHT,
                size: 65,
                backgroundBorderColor: red,
                color: "gold",
                rollColor: red,
                bold: true,
                italic: true
            }).pos(370, 50).addTo(page4);

            new Emoji("\u270f\ufe0f", 100).pos(430, 50).addTo(page4).drag()
            .animate({
                props: { rotation: 90 },
                loop: true,
                time: 2,
            });



            ///////////
            
            STYLE = {
                Arrow: {
                    type: "angle",
                    pages: pages,
                    //direction: series(RIGHT, LEFT),
                    trans: "fan",
                    rotation: series(0, 180)
                }
            }
            new Arrow(red, green, pages, RIGHT).pos(50, 50, RIGHT, BOTTOM);
            new Arrow(red, green, pages, LEFT).pos(50, 50, LEFT, BOTTOM);

            //physics.debug()
        })
    </script>
</body>

</html>