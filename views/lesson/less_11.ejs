        <ul class="grid12 no_list questions_2_1">
                <li>
                    <span class="bold lesson_color">1.</span> <input size="8" type="text" autocomplete="off"/>.
                </li>
                <li>
                    <span class="bold lesson_color">2.</span> <input size="8" type="text" autocomplete="off"/>.
                </li>
                <li>
                    <span class="bold lesson_color">3.</span> <input size="8" type="text" autocomplete="off"/> 
                </li>
                <li>
                    <span class="bold lesson_color">4.</span> <input size="8" type="text" autocomplete="off"/>.
                </li>
                <li>
                    <span class="bold lesson_color">5.</span> <input size="8" type="text" autocomplete="off"/>.
                </li>
        </ul>
        <div class="btn_activities">
                <div id="check_answers_2_1">
                    <span>Check</span>
                </div>
                <div id="reset_answers_2_1">
                    <span>Reset</span>
                </div>
                <div id="answers_2_1">
                    <span>Answers</span>
                </div>
        </div>


