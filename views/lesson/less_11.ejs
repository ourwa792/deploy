<style> 
  .table-container {
            margin: 20px auto;
            max-width: 900px;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
    }
    .table {
            margin-bottom: 0;
    }
    .table th, .table td {
        vertical-align: middle;
        text-align: center;
    }
    .image-cell {
        max-width: 100px;
    }
    img {
        max-width: 100%;
        height: auto;
    }
    .highlight {
        background-color: #f0f8ff;
    }

</style>

<body class="container">

