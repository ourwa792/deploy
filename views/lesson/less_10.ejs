<style>
    #jxgbox {
        max-width: 100%;
        height: 130px;
        border: 1px solid black;
        direction: ltr;
        
    }
    body{
            font-size: larger;
        }
    .table-custom {
        border: 2px solid #d18fd1;
        width: 100%;
    }
    .table-custom th, .table-custom td {
        border: 1px solid #d18fd1;
        text-align: center;
        width: 50%;
    }
    .highlighted-text {
        background-color: #f7d7d7;
        padding: 5px;
        border-radius: 5px;
    }
    .arrow {
        font-size: 1.5rem;
        color: orange;
    }
    image{
        border: 2px solid #5aea1c;
    }

    /* توصيل */
    .matching-container {
            position: relative;
            width: 100%;
            max-width: 1200px;
            margin: auto;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    }
    .matching-item {
            padding: 15px;
            background-color: #ffffff;
            border: 2px solid #ddd;
            cursor: pointer;
            text-align: center;
            border-radius: 5px;
            transition: background-color 0.3s ease;
            margin-bottom: 20px;
    }.matching-item img {
            max-width: 100%;
            height: auto;
            border-radius: 7px;
            max-height: 300px;
            object-fit: contain;
        }
        .correct {
            background-color: #c8e6c9 !important;
            animation: correctAnimation 1s ease-in-out;
        }
        .wrong {
            background-color: #ffcdd2 !important;
            animation: wrongAnimation 1s ease-in-out;
        }
        @keyframes correctAnimation {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        @keyframes wrongAnimation {
            0% { transform: scale(1); }
            50% { transform: scale(0.95); }
            100% { transform: scale(1); }
        }.feedback {
            position: fixed;
            bottom: 10px;
            right: 10px;
            padding: 10px;
            background-color: #333;
            color: white;
            border-radius: 5px;
            display: none;
        }

        /* زيادة التباعد الأفقي بين الأعمدة */
        .offset-space {
            margin-left: 70px;
        }

        @media (max-width: 768px) {
            .matching-container {
                padding: 10px;
            }
            .matching-item {
                margin-bottom: 15px;
            }
            .offset-space {
                margin-left: 0;
            }
        }
</style>

</head>

