        <script type="module">
                        import {
                           MathfieldElement,
                           renderMathInDocument,
                           renderMathInElement,
                       } from "//unpkg.com/mathlive?module"; 

            window.addEventListener("DOMContentLoaded", () => {
                    renderMathInDocument({
                       TeX: {
                           delimiters: {
                               inline: [
                                   ["$", "$"],
                                   ["\\(", "\\)"],
                               ],
                               display: [
                                   ["\\[", "\\]"],
                                   ["$$", "$$"],
                               ],
                           },
                       },
                   }); 

                createDragAndDrop({
                    options_html: '.answer_options_4_1',
                    questions_html: '.answers_place_4_1',
                    check_button: '#check_answers_4_1',
                    reset_button: '#reset_answers_4_1',
                    answer_button: '#answers_4_1',
                    answers: [2, 1, 3]
                });

                const btn = document.getElementById("btn1"); // تحديد جميع الأزرار
                const audio = new Audio(btn.getAttribute("data-sound"));

                btn.addEventListener("click", (e) => {
                    if (!audio.playing) {
                        audio.play();
                        btn.disabled = true; // تعطيل الزر أثناء تشغيل الصوت

                        audio.onended = () => {
                            btn.disabled = false;
                        };
                    }
                });

                Object.defineProperty(audio, "playing", {
                    get: function () {
                        return !this.paused && !this.ended;
                    },
                });

                var brd = JXG.JSXGraph.initBoard("jxgbox", {
                    boundingbox: [-6, 6, 6, -6],
                    keepaspectratio: true,
                    axis: true,
                });

                var tape = brd.create('tapemeasure', [[1, 2], [4, 2]], { name: 'مسطرة', fontSize: 20, label: "مسطرة" });

                var img = brd.create('image', [
                    '/image/protractor.svg', // رابط الصورة
                    [-2, -2], // إحداثيات الزاوية السفلى اليسرى
                    [6, 3.2]  //حجم الصورة (عرض وارتفاع)
                ], { cssClass: "opacity: 1" });

                brd.create("button", [4, 5.4, " تدوير لليمين",
                    function () {
                        let rotate = 0
                        rotate += 5
                        img.setAttribute({
                            draggable: true,
                            rotate: rotate
                        })
                    }
                ], { cssClass: 'background-color: green' });

                brd.create("button", [-4, 5.4, " تدوير لليسار",
                function () {
                    let rotate = 0
                    rotate -= 5
                    img.setAttribute({
                        draggable: true,
                        rotate: rotate
                    })
                }
                ], { cssClass: '' });


                var points = []; // لتخزين النقاط للمضلع الحالي
                var polygonComponents = []; // لتخزين عناصر المضلع مثل النقاط والخطوط
                var drawingMode = 'polygon'; // الوضع الافتراضي لرسم المضلعات
                var interactionMode = false; // وضع التفاعل الافتراضي (مغلق)

                // دالة لإعادة تعيين النقاط الحالية للمضلع
                function resetPolygon() {
                    points = [];
                }

                // دالة لإنشاء مضلع عندما يكتمل
                function createPolygon() {
                    if (points.length > 2) { // تأكد من وجود 3 نقاط على الأقل
                        var polygon = brd.create('polygon', points, {
                            borders: { strokeWidth: 3 },
                            hasInnerPoints: true,
                        });
                        //console.info(points)
                        var areaText = brd.create('text', [
                            points[0].X(), points[0].Y(),
                            function () { return 'Area: ' + polygon.Area().toFixed(2); }
                        ]);

                        polygonComponents.push(polygon);
                        resetPolygon();
                    }
                }

                // دالة لإنشاء قطعة مستقيمة بين نقطتين
                function createLineSegment() {
                    if (points.length === 2) { // تأكد من وجود نقطتين فقط
                        var lineSegment = brd.create('segment', [points[0], points[1]], {
                            strokeWidth: 3,
                        });
                        polygonComponents.push(lineSegment);
                        resetPolygon();
                    }
                }

                // دالة للتحقق من المسافة للنقر بالقرب من النقطة الأولى لإغلاق المضلع
                function checkFirstPoint(coords) {
                    if (points.length > 2 && drawingMode === 'polygon') {
                        var firstPoint = points[0];
                        var distance = JXG.Math.Geometry.distance(coords.usrCoords.slice(1), firstPoint.coords.usrCoords.slice(1));
                        if (distance < 0.2) { // إذا كانت النقطة قريبة من النقطة الأولى بما يكفي
                            createPolygon();
                            return true;
                        }
                    }
                    return false;
                }

                // دالة للتعامل مع النقر على اللوحة
                function down(e) {
                    if (interactionMode) return; // عند تفعيل وضع التفاعل، يتم تعطيل إضافة الأشكال الجديدة

                    var coords = getMouseCoords(e);

                    if (!checkFirstPoint(coords)) {
                        var newPoint = brd.create('point', [coords.usrCoords[1], coords.usrCoords[2]]);
                        points.push(newPoint);
                        polygonComponents.push(newPoint);

                        // إضافة قطعة مستقيمة بين آخر نقطتين
                        if (points.length > 1) {
                            if (drawingMode === 'line') {
                                createLineSegment(); // إنشاء قطعة مباشرة في وضع الخط
                            } else {
                                var newLine = brd.create('line', [points[points.length - 2], points[points.length - 1]], {
                                    straightFirst: false,
                                    straightLast: false,
                                    strokeWidth: 2
                                });
                                polygonComponents.push(newLine);
                            }
                        }
                    }
                }

                // دالة للحصول على إحداثيات الفأرة
                function getMouseCoords(e) {
                    var cPos = brd.getCoordsTopLeftCorner(e),
                        absPos = JXG.getPosition(e);

                    var dx = absPos[0] - cPos[0];
                    var dy = absPos[1] - cPos[1];

                    return new JXG.Coords(JXG.COORDS_BY_SCREEN, [dx, dy], brd);
                }

                // تسجيل حدث النقر على اللوحة
                brd.on('down', down);

                // دالة لتبديل وضع التفاعل
                function toggleInteractionMode() {
                    interactionMode = !interactionMode;
                    var modeText = interactionMode ? "Interaction Mode ON" : "Interaction Mode OFF";
                    console.log(modeText); // أو يمكن استبدال هذا بأية واجهة مستخدم لإظهار الوضع الحالي
                }

                // زر لتبديل وضع التفاعل
                document.getElementById('toggleInteractionBtn').addEventListener('click', toggleInteractionMode);

                // دالة إعادة تعيين اللوحة
                function resetBoard() {
                    while (polygonComponents.length > 0) {
                        brd.removeObject(polygonComponents.pop());
                    }

                    points = [];
                    polygonComponents = [];
                    brd.update();
                }

                // دالة لتغيير وضع الرسم بين مضلع وقطعة مستقيمة
                function switchDrawingMode(mode) {
                    drawingMode = mode;
                }

                // أزرار لتغيير وضع الرسم
                document.getElementById('polygonModeBtn').addEventListener('click', function () {
                    switchDrawingMode('polygon');
                });

                document.getElementById('lineModeBtn').addEventListener('click', function () {
                    switchDrawingMode('line');
                });

                // زر إعادة تعيين اللوحة
                document.getElementById('resetBoardBtn').addEventListener('click', resetBoard);

                createMultipleChoice({
                    questions_html: '.questions_1',
                    check_button: '#check_answers_1',
                    reset_button: '#reset_answers_1',
                    answer_button: '#answers_1',
                    answers: [
                        ['CD', 'DC'],
                        ['AD', 'DA'],
                        ['BC', 'CB'], ['2'],
                        ['4'],
                        ['C', 'D', 'D', 'C'],
                    ]
                });

                createFalseAndTrue({
                    questions_html: '.questions_7_1',
                    check_button: '#check_answers_7_1',
                    reset_button: '#reset_answers_7_1',
                    answer_button: '#answers_7_1',
                    answers: [1, 2, 1]
                });

                var board = JXG.JSXGraph.initBoard('jxgbox2',{boundingbox: [-10, 10, 8, -8],
                    axis:true
                });

                var X = board.create("point", [-7, -4], {name: "X"})
                var Y = board.create("point", [-7, 4], {name: "Y"})
                var Z = board.create("point", [7, 4], {name: "Z"})

                let xy = board.create("segment", [X,Y])
                let zy = board.create("segment", [Z,Y])

                board.create("text", [-7,1, ()=>{return xy.L()+"cm"} ], {fontSize:20, strokeColor: "green"})
                board.create("text", [0,5, ()=>{return zy.L()+"cm"} ], {fontSize:20, strokeColor: "green"})

                var t = board.create('turtle',[0, 0], {strokeOpacity:0.5});
                t.setPenSize(3)

                // Function to move the turtle forward
                document.getElementById('moveForward').addEventListener("click", ()=> {
                    t.forward(.5);
                })

                // Function to move the turtle backward
                document.getElementById('moveBackward').addEventListener("click", ()=> {
                    t.back(.5);
                }) 

                // Function to turn the turtle left
                document.getElementById('turnLeft').addEventListener("click", ()=> {
                    t.left(30);
                })                  

                // Function to turn the turtle right
                document.getElementById('turnRight').addEventListener("click", ()=> {
                    t.right(30);
                })               
                
                // Function to clear the screen
                document.getElementById('clearScreen').addEventListener("click", ()=> {
                    t.clearScreen();
                })

                document.getElementById('moveWithoutDrawing').addEventListener("click", ()=> {
                    t.penUp()
                })

                document.getElementById('draw').addEventListener("click", ()=> {
                    t.penDown()
                })               

                const successSound = new Audio("/sound/rightanswer.mp3");

                const targetPoints = [
                  { x: 7, y: -4, description: "حدد النقطة عند (4-, 7)" },
                ]       
                
                let currentTargetIndex = 0;

                function checkPoint(x, y){
                    const target = targetPoints[currentTargetIndex];
                    const tolerance = 0.7;

                    if (Math.abs(x - target.x ) <= tolerance
                        && Math.abs(y - target.y) <= tolerance
                    ) {
                        board.create("text", [0, -4, "أحسنت"], {
                            fontSize: 18,
                            anchorX: "left",
                            color: "green",
                        });

                        successSound.play().catch((error) => console.error("تعذر تشغيل الصوت:", error));
                    }
                    else {
                        board.create("text", [0, -6, "النقطة خاطئة"], {
                            fontSize: 18,
                            anchorX: "left",
                            color: "red",
                        });
                    }
                };

                board.on("down", function (e) {
                        var coords = board.getCoordsTopLeftCorner(e),
                        absPos = JXG.getPosition(e),
                        dx = absPos[0] - coords[0],
                        dy = absPos[1] - coords[1],
                        boardCoords = new JXG.Coords(JXG.COORDS_BY_SCREEN, [dx, dy], board);

                        var x = parseFloat(boardCoords.usrCoords[1].toFixed(2));
                        var y = parseFloat(boardCoords.usrCoords[2].toFixed(2));
              
                        board.create("point", [x, y], {
                            name: "(" + x + ", " + y + ")",
                            size: 4,
                            color: "blue",
                            fontSize:17
                        });
              
                      checkPoint(x, y);             
                   })
                })


        </script>


