<%- include ('./partial/head.ejs') %>
    <link rel="stylesheet" href="/css/survey.css" />
    <link href="/css/toastify.min.css" rel="stylesheet">

<!--     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
 -->

    <script lang="text/javascript" src="/library/jquery.min.js"> </script>

    <script lang="text/javascript" src="/library/survey.jquery.min.js"> </script>
    <script lang="text/javascript" src="/library/survey.jquery.theme.index.min.js"> </script>

    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    <script src="/library/toastify-js.js"></script>

    <style>
        .spinner {
            display: none;
            font-size: 24px;
            margin-top: 10px;
        }
    </style>

    </head>

    <body class="container border border-info ">
        <%- include ('./partial/navBar.ejs') %>
            <div class="container border border-info">
                <div class="row mt-5">

                    <div class="col-lg-6 col-sm-12">

                        <div class="card shadow">
                            <div class="card-header">
                                <% if (user.isAdmin) { %>
                                    <h2 class="fw-bold text-secondary">حساب المدير</h2>
                                    <% }else { %>
                                        <h2 class="fw-bold text-secondary">حساب الطالب</h2>
                                        <% } %>
                            </div>
                            <div class="card-body p-4">

                                <% if (error && error.length> 0) { %>
                                    <div class="alert alert-danger">
                                        <% error.forEach(function(err) { %>
                                            <p>
                                                <%= err %>
                                            </p>
                                            <% }); %>
                                    </div>
                                    <% } %>

                                        <% if (success && success.length> 0) { %>
                                            <div class="alert alert-success">
                                                <% success.forEach(function(msg) { %>
                                                    <p>
                                                        <%= msg %>
                                                    </p>
                                                    <% }); %>
                                            </div>
                                            <% } %>

                                                <div class="text-center mb-3">
                                                    <% if (user.avatar) { %>
                                                        <img src="<%= user.avatar %>" alt="Profile Image"
                                                            class="img-thumbnail" style="width: 150px; height: 150px;">
                                                        <% } %>

                                                </div>
                                                <form id="profileImageForm" enctype="multipart/form-data" class="form-control mb-4">
                                                    <div class="mb-3">
                                                        <label for="profileImage" class="form-label">ارفع صورة
                                                            لحسابك</label>
                                                        <input class="form-control form-control-sm" type="file" id="profileImage"
                                                            name="profileImage">
                                                    </div>
                                                    <button type="submit" class="btn btn-primary btn-sm">اختر صورة لحسابك</button>
                                                </form>                                                    
                                                    <!-- مكان عرض الصورة التي تم رفعها -->
                                                    <div class="container" id="previewContainer">
                                                        <img id="previewImage" src="" alt="Preview" style="display: none; width: 150px; height: 150px; border-radius: 50%; border: 1px solid #ddd;">
                                                        <div id="spinner" class="spinner" style="display: none;">
                                                                <i class="fas fa-spinner fa-spin"></i> جاري الرفع...
                                                        </div>
                                                      
                                                    </div>

                                                <table class="table table-striped table-responsive">
                                                    <tr>
                                                        <th>اسم المستخدم</th>
                                                        <td>
                                                            <%= user.userName %>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>الايميل</th>
                                                        <td>
                                                            <%= user.email %>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>تاريخ الانشاء :</th>
                                                        <td>
                                                            <%= user.createdAt %>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>تسجيل الخروج</th>
                                                        <td>
                                                            <form action="/logout" method="post">
                                                                <button type="submit" class="btn btn-danger">
                                                                    Log out
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>

                                                </table>

                                                <a class="border-info btn btn-outline-success nav-link"
                                                    href="/forgotPassword">
                                                    <strong>إعادة تعيين كلمة المرور</strong>
                                                </a>

                            </div>


                        </div>

                    </div>


                    <div class="col-lg-6 col-sm-12">
                        <div class="card shadow-lg">
                            <div class="card-header">
                                <h2 class="fw-bold text-center text-secondary">تقييماتي</h2>
                            </div>
                            <div class="card-body p-4">
                                <% if (feedbacks && feedbacks.length> 0) { %>
                                    <div class="accordion" id="feedbackAccordion">
                                        <% feedbacks.forEach((feedback, index)=> { %>
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="heading<%= index %>">
                                                    <button class="accordion-button" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>"
                                                        aria-expanded="true" aria-controls="collapse<%= index %>">
                                                        التقييم لدرس: <%= feedback.lesson.title %> (توقيت: <%=
                                                                feedback.createdAt %>)
                                                    </button>
                                                </h2>
                                                <div id="collapse<%= index %>" class="accordion-collapse collapse"
                                                    aria-labelledby="heading<%= index %>"
                                                    data-bs-parent="#feedbackAccordion">
                                                    <div class="accordion-body">
                                                        <div id="surveyElement<%= feedback.id %>"></div>
                                                        <script>
                                                            (function () {
                                                                const surveyData = <%- feedback.rating ? JSON.stringify(feedback.rating) : '{}' %>;
                                                                const surveyModel = new Survey.Model({
                                                                    "pages": [{
                                                                        "name": "rating-questions",
                                                                        "elements": [{
                                                                            "type": "rating",
                                                                            "name": "well-prepared",
                                                                            "title": "إلى أي مدى كانت تجربتك مع هذا الدرس جيدة ؟",
                                                                            "rateType": "smileys",
                                                                            "autoGenerate": false,
                                                                            "rateCount": 4,
                                                                            "rateValues": [
                                                                                "يحتاج إلى تحسين ",
                                                                                "راض عنه",
                                                                                "جيد ",
                                                                                "ممتاز"
                                                                            ],
                                                                            "minRateDescription": "يحتاج إلى تحسين ",
                                                                            "maxRateDescription": "ممتاز"
                                                                        },
                                                                        {
                                                                            "type": "comment",
                                                                            "name": "comments",
                                                                            "title": "أضف اقتراحات أو تعليقات",
                                                                            "hideNumber": true,
                                                                            "rows": 3,
                                                                            "autoGrow": true
                                                                        }
                                                                        ]
                                                                    }],
                                                                    "showQuestionNumbers": "onPage",
                                                                    "completeText": "Submit",
                                                                    "firstPageIsStarted": true,
                                                                    "widthMode": "static",
                                                                    "width": "1200",
                                                                    "headerView": "advanced"
                                                                });
                                                                surveyModel.data = surveyData;
                                                                surveyModel.showTitle = false;
                                                                surveyModel.showCompletedPage = true;
                                                                surveyModel.showNavigationButtons = false;
                                                                surveyModel.mode = "display";
                                                                $('#surveyElement<%= feedback.id %>').Survey({
                                                                    model: surveyModel
                                                                });
                                                            })();
                                                        </script>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <p>لا يوجد تقييمات بعد.</p>
                                        <% } %>


                            </div>

                        </div>

                        <div class="col-sm-12 my-3">
                            <div class="card shadow-lg">
                                <div class="card-header">
                                    <h2 class="fw-bold d-inline-block d-flex text-center text-bg-info border-5 rounded-5 justify-content-center align-items-center"> 
                                         أدائي في الاختبارات
                                    </h2>
                                </div>
                                <div class="card-body p-4">
    
                                    <a href="/quiz/attempts" class="dropdown-item container text-start">
                                        <img src="/icon/iconPerformance.png" class="bi mx-3" width="34" height="43">
                                    </a>
    
                                        <strong>أدائي في الاختبارات</strong>
                                    </a>
                                </div>
    
                            </div>
    
                        </div>



                        <div class="col-sm-12 my-3">
                            <div class="card shadow-lg">
                                <div class="card-header">
                                    <h2 class="fw-bold d-inline-block d-flex text-center text-bg-info border-5 rounded-5 justify-content-center align-items-center"> 
                                        المنتدى</h2>
                                </div>
                                <div class="card-body p-4">
                                    <a class="border-info btn btn-outline-success nav-link"
                                    href="/board">
                                        <strong>الذهاب</strong>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>


<script>  
$(document).ready(function () {
  $("#profileImage").on("change", function (e) {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function (e) {
        $("#previewImage").attr("src", e.target.result).show();
      };
      reader.readAsDataURL(file);
    }
  });

  $("#profileImageForm").on("submit", function (e) {
    e.preventDefault();

    const fileInput = $("#profileImage")[0].files[0];

  /*   if (!fileInput) {
      $("#responseMessage").text("يرجى اختيار صورة للرفع.").css("color", "red");
      return;
    }

    // التحقق من نوع وحجم الملف
    const allowedTypes = ["image/jpeg", "image/png"];
    if (!allowedTypes.includes(fileInput.type)) {
      $("#responseMessage").text("الملف يجب أن يكون صورة بصيغة JPG أو PNG.").css("color", "red");
      return;
    }

    if (fileInput.size > 2 * 1024 * 1024) {
      $("#responseMessage").text("حجم الملف يجب ألا يتجاوز 2 ميغا.").css("color", "red");
      return;
    } */

    const formData = new FormData(this);

   /*  if (!fileInput) {
      $("#responseMessage")
        .text("Please select an image to upload.")
        .css("color", "red");
      return;
    } */

    // مؤشر تحميل
    $("#spinner").show();
    $("#previewImage").hide();
    
    $.ajax({
      url: "/api/upload-profile-image",
      type: "POST",
      data: formData,
      processData: false,
      contentType: false,
      success: function (response) { 
        console.log("response is sccess"+response)
        $("#spinner").hide(); // إخفاء السبينر
        if (response.success) {
            swal({
                title: "تم بنجاح!",
                text: response.message,
                icon: "success",
                buttons: true,
                timer: 3000, // مدة العرض (3 ثوانٍ)
                showConfirmButton: false, // إخفاء زر التأكيد
            }).then(() => {
                window.location.reload(); // إعادة تحميل الصفحة عند انتهاء التوست
            });
                        
            $("#profileImageForm")[0].reset(); // تفريغ الحقول
            //setTimeout(window.location.reload(),23000)
        } else {
            /* Toastify({
                text: response.message,
                duration: 3000,
                close: true,
                gravity: "top", // `top` or `bottom`
                position: "center", // `left`, `center` or `right`
                backgroundColor: "linear-gradient(to right, #f170a4, #f52a7c)",
                stopOnFocus: true, // Prevents dismissing of toast on hover
            }).showToast(); */
            swal({
                title: "حدث خطأ !",
                text: response.message,
                icon: "error",
                buttons: true,
                timer: 3000, // مدة العرض (3 ثوانٍ)
                showConfirmButton: false, // إخفاء زر التأكيد
            })

            $("#profileImageForm")[0].reset(); // تفريغ الحقول
        }
      },
      error: function (xhr, status, error) {
        console.log('===xhr==='+JSON.stringify(xhr));
        $("#spinner").hide(); // إخفاء السبينر

        const errorMessage = xhr.responseJSON?.message || "حدث خطأ غير متوقع.";
        console.log('errorMessage is ' + errorMessage)
        /* Toastify({
            text: errorMessage,
            duration: 3000,
            close: true,
            gravity: "top", // `top` or `bottom`
            position: "center", // `left`, `center` or `right`
            backgroundColor: "linear-gradient(to right, #f170a4, #f52a7c)",
            stopOnFocus: true, // Prevents dismissing of toast on hover
        }).showToast(); */
        swal({
            title: "حدث خطأ !",
            text: errorMessage,
            icon: "error",
            timer: 3000, // مدة العرض (3 ثوانٍ)
            showConfirmButton: false, // إخفاء زر التأكيد
        })

        $("#profileImageForm")[0].reset(); // تفريغ الحقول

      },
    });
  });
});
    
</script>


<%- include ('./partial/end.ejs') %>