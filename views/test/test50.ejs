        //board.update();

        const slider = board.create('slider', [[-5, 5], [-2, 5], [4, 6, 40]], {
                name: 'عدد القطاعات',
                snapWidth: 1
            });

            // دائرة
            const r = 5; // نصف القطر
            const circle = board.create('circle', [[0, 0], r], {
                strokeWidth: 2,
                strokeColor: 'black',
                fillOpacity: 0.1
            });

            // القطاعات
            let sectors = [];

            const updateSectors = () => {
                // إزالة القطاعات القديمة
                sectors.forEach(sector => board.removeObject(sector));
                sectors = [];

                const n = Math.floor(slider.Value()); // عدد القطاعات
                const phi = 2 * Math.PI / n; // الزاوية لكل قطاع
                const center = [0, 0];

                // إنشاء القطاعات
                for (let i = 0; i < n; i++) {
                    const angle1 = i * phi;
                    const angle2 = (i + 1) * phi;

                    const p1 = board.create('point', [
                        center[0] + r * Math.cos(angle1),
                        center[1] + r * Math.sin(angle1)
                    ], { visible: false });

                    const p2 = board.create('point', [
                        center[0] + r * Math.cos(angle2),
                        center[1] + r * Math.sin(angle2)
                    ], { visible: false });

                    const centerPoint = board.create('point', center, { visible: false });

                    const sector = board.create('sector', [centerPoint, p1, p2], {
                        fillColor: (i % 2 === 0) ? 'orange' : 'lightblue',
                        fillOpacity: 0.6,
                        strokeColor: 'black',
                        strokeWidth: 1
                    });

                    sectors.push(sector);
                }
            };

            // ترتيب القطاعات لإظهار المستطيل
            const arrangeSectors = () => {
                const n = Math.floor(slider.Value());
                const phi = 2 * Math.PI / n;

                // إزالة القطاعات القديمة
                sectors.forEach(sector => board.removeObject(sector));
                sectors = [];

                for (let i = 0; i < n; i++) {
                    const angle = i * phi;
                    const xBase = i % 2 === 0 ? i * (2 * Math.PI * r / n) : i * (2 * Math.PI * r / n);
                    const yBase = i % 2 === 0 ? r : -r;

                    const p1 = board.create('point', [xBase, yBase], { visible: false });
                    const p2 = board.create('point', [xBase + (2 * Math.PI * r / n), yBase], { visible: false });

                    const sector = board.create('polygon', [p1, p2], {
                        fillColor: (i % 2 === 0) ? 'orange' : 'lightblue',
                        fillOpacity: 0.6,
                        strokeColor: 'black',
                        strokeWidth: 1
                    });

                    sectors.push(sector);
                }
            };

            // رسم القطاعات الأولية
            slider.on('drag', () => {
                updateSectors();
                arrangeSectors();
            });

