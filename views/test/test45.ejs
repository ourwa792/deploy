// دالة لإيجاد نقطة تقاطع محسوبة كنسبة من رأس الهرم
function findScaledPoint(apex, basePoint, scale) {
    return [
        apex.X() + scale * (basePoint.X() - apex.X()),
        apex.Y() + scale * (basePoint.Y() - apex.Y()),
        apex.Z() + scale * (basePoint.Z() - apex.Z())
    ];
}

// دالة حساب نقاط تقاطع الهرم مع المستوى للحصول على مضلع مشابه للقاعدة
function calculateIntersectionPolygon() {
    var intersectionPoints = [];
    
    // حساب النسبة من رأس الهرم إلى المستوى
    var scale = (planePoint.Z() - apex.Z()) / (base1.Z() - apex.Z());

    // حساب النقاط المحسوبة لكل نقطة قاعدة باستخدام النسبة
    [base1, base2, base3, base4].forEach(function(basePoint) {
        var intersection = findScaledPoint(apex, basePoint, scale);
        var p3d = view.create('point3d', intersection, {size: 2, color: 'red'});
        intersectionPoints.push(p3d);
    });

    return intersectionPoints;
}

// إنشاء المضلع الناتج من التقاطع
var intersectionPolygon;

function updateIntersection() {
    // إزالة المضلع القديم
    if (intersectionPolygon) {
        board.removeObject(intersectionPolygon);
    }
    
    // حساب نقاط التقاطع وإنشاء مضلع التقاطع
    var points = calculateIntersectionPolygon();
    if (points.length >= 3) {
        intersectionPolygon = view.create('polygon3d', points, {
            fillColor: 'purple',
            fillOpacity: 0.5,
            strokeColor: 'purple',
            strokeWidth: 2
        });
