  <div class="mathcell" style="width: 6in; height: 5in">
    <script>

      var parent = document.currentScript.parentNode;

      // إنشاء واجهة التحكم
      var id = generateId();
      parent.id = id;

      // عناصر التحكم: زاوية المستوى وموقعه
      MathCell(id, [
        { type: 'slider', name: 'angle', label: 'زاوية المستوى:', min: -90, max: 90, step: 1, value: 0 },
        { type: 'slider', name: 'position', label: 'موقع المستوى:', min: -5, max: 5, step: 0.1, value: 0 }
      ]);

      // تحديث العرض بناءً على التفاعل
      parent.update = function (id) {
        var angle = getVariable(id, 'angle');
        var position = getVariable(id, 'position');

        // زاوية الدوران لمستوى القص
        var rad = angle * Math.PI / 180;
        var normal = [Math.sin(rad), Math.cos(rad), 0];

        // تعريف الهرم باستخدام parametric
        var pyramid = parametric(
          (u, v) => {
            var base = 5; // عرض القاعدة
            var height = 5; // ارتفاع الهرم
            var x = (1 - u) * base * Math.cos(v);
            var y = (1 - u) * base * Math.sin(v);
            var z = u * height;
            return [x, y, z];
          },
          [0, 1], [0, 2 * Math.PI],
          { colormap: 'cool', opacity: 0.8 }
        );

        // إضافة مستوى القص
        var cuttingPlane = parametric(
          (u, v) => {
            return [
              u,
              v,
              position // الموقع العمودي للمستوى
            ];
          },
          [-5, 5], [-5, 5],
          { color: 'red', opacity: 0.5 }
        );

        // الإعدادات النهائية للمشهد
        var config = { type: 'threejs', frame: true };

        evaluate(id, [pyramid, cuttingPlane], config);
      };

      // استدعاء التحديث الأولي
      parent.update(id);

    </script>
  </div>



  <div class="mathcell" style="width: 8in; height: 8in">
    <script>

      var parent = document.currentScript.parentNode;

      // إنشاء واجهة التحكم
      var id = generateId();
      parent.id = id;

      // عناصر التحكم: زاوية المستوى وموقعه
      MathCell(id, [
        { type: 'slider', name: 'angle', label: 'زاوية المستوى:', min: -90, max: 90, step: 1, value: 0 },
        { type: 'slider', name: 'position', label: 'موقع المستوى:', min: -5, max: 5, step: 0.1, value: 0 },
        { type: 'checkbox', name: 'challenge', label: 'تفعيل التحدي: دائرة' }
      ]);

      // تحديث العرض بناءً على التفاعل
      parent.update = function (id) {
        var angle = getVariable(id, 'angle');
        var position = getVariable(id, 'position');
        var challenge = getVariable(id, 'challenge');

        // زاوية الدوران للمستوى
        var rad = angle * Math.PI / 180;
        var normal = [Math.sin(rad), Math.cos(rad), 0];

        // تعريف الهرم باستخدام parametric
        var pyramid = parametric(
          (u, v) => {
            var base = 5; // عرض القاعدة
            var height = 5; // ارتفاع الهرم
            var x = (1 - u) * base * Math.cos(v);
            var y = (1 - u) * base * Math.sin(v);
            var z = u * height;
            return [x, y, z];
          },
          [0, 1], [0, 2 * Math.PI],
          { colormap: 'cool', opacity: 0.8 }
        );

        // حساب نقاط التقاطع بين المستوى والهرم
        var intersections = [];
        for (var u = 0; u <= 1; u += 0.01) {
          for (var v = 0; v <= 2 * Math.PI; v += 0.1) {
            var base = 5;
            var height = 5;
            var x = (1 - u) * base * Math.cos(v);
            var y = (1 - u) * base * Math.sin(v);
            var z = u * height;

            // معادلة المستوى
            if (Math.abs(normal[0] * x + normal[1] * y + normal[2] * z - position) < 0.1) {
              intersections.push([x, y, z]);
            }
          }
        }

        // إضافة مستوى القص
        var cuttingPlane = parametric(
          (u, v) => {
            return [u, v, position];
          },
          [-5, 5], [-5, 5],
          { color: 'red', opacity: 0.5 }
        );

        // إضافة خطوط المقطع
        var sectionLines = line(intersections, { color: 'blue', thickness: 2 });

        // التحدي التفاعلي
        if (challenge && Math.abs(angle) < 1 && Math.abs(position) < 0.5) {
          alert('أحسنت! حصلت على مقطع دائري.');
        }

        // الإعدادات النهائية للمشهد
        var config = { type: 'threejs', frame: true };

        evaluate(id, [pyramid, cuttingPlane, sectionLines], config);
      };

      // استدعاء التحديث الأولي
      parent.update(id);

    </script>
  </div>


