    <div class="mathcell" style="width: 6in; height: 6in">
      <script>
      var parent = document.currentScript.parentNode;
      var id = generateId();
      parent.id = id;
      
      // إضافة منزلق للتحكم بارتفاع المستوى
      MathCell(id, [
        { type: 'slider', name: 'cutHeight', label: 'Cut Height:', min: 0.1, max: 5, value: 2 }
      ]);
      
      parent.update = function (id) {
        var cutHeight = getVariable(id, 'cutHeight'); // قيمة ارتفاع المستوى القاطع
      
        var pyramidHeight = 5; // ارتفاع الهرم
        var baseSize = 2; // نصف طول قاعدة الهرم
      
        // تعريف المستوى كسطح بارامتري
        var plane = parametric(
          (u, v) => [u, v, cutHeight], // معادلة المستوى
          [-baseSize, baseSize],
          [-baseSize, baseSize],
          { color: 'rgba(255, 0, 0, 0.4)' } // لون شفاف للمستوى
        );
      
        // تعريف أوجه الهرم كمسطحات بارامترية
        var faces = [
          parametric(
            (u, v) => [
              (1 - u) * (-baseSize) + u * v * (0),
              (1 - u) * (-baseSize) + u * v * (pyramidHeight),
              u * pyramidHeight
            ],
            [0, 1],
            [0, 1],
            { color: 'rgb(0, 127, 255)', opacity: 0.6 }
          ),
          parametric(
            (u, v) => [
              (1 - u) * (baseSize) + u * v * (0),
              (1 - u) * (-baseSize) + u * v * (pyramidHeight),
              u * pyramidHeight
            ],
            [0, 1],
            [0, 1],
            { color: 'rgb(0, 127, 255)', opacity: 0.6 }
          ),
          parametric(
            (u, v) => [
              (1 - u) * (baseSize) + u * v * (0),
              (1 - u) * (baseSize) + u * v * (pyramidHeight),
              u * pyramidHeight
            ],
            [0, 1],
            [0, 1],
            { color: 'rgb(0, 127, 255)', opacity: 0.6 }
          ),
          parametric(
            (u, v) => [
              (1 - u) * (-baseSize) + u * v * (0),
              (1 - u) * (baseSize) + u * v * (pyramidHeight),
              u * pyramidHeight
            ],
            [0, 1],
            [0, 1],
            { color: 'rgb(0, 127, 255)', opacity: 0.6 }
          )
        ];
      
        // حساب نقاط تقاطع المستوى مع الأوجه
        var intersectionLines = [];
        faces.forEach(face => {
          var line = isoline(
            (x, y, z) => z - cutHeight, // معادلة المستوى
            [-baseSize, baseSize],
            [-baseSize, baseSize],
            { color: 'rgb(255, 255, 0)', thickness: 2 }
          );
          intersectionLines.push(line);
        });
      
        // إعدادات العرض
        var config = { type: 'threejs', frame: true, animate: true };
      
        evaluate(id, [plane, ...faces, ...intersectionLines], config);
      };
      
      parent.update(id);
      </script>
      </div>
      




</body>

</html>