    calculator.setExpression({ id: 'circle', latex: '(x)^2 + (y)^2 = 25' });

        // Define draggable points A and B on the circle
        calculator.setExpression({ id: 'pointA', latex: '(5 * cos(\\theta_1), 5 * sin(\\theta_1))', showLabel: true, label: 'A' });
        calculator.setExpression({ id: 'pointB', latex: '(5 * cos(\\theta_2), 5 * sin(\\theta_2))', showLabel: true, label: 'B' });

        // Central angle (theta) between points A and B
        calculator.setExpression({
            id: 'centralAngle',
            latex: '\\theta = \\arccos(\\cos(\\theta_1 - \\theta_2))',
            showLabel: true,
            label: 'Central Angle'
        });

        // Add lines connecting the center of the circle to the points A and B
        calculator.setExpression({ id: 'radiusA', latex: 'y = (5 * sin(\\theta_1) / (5 * cos(\\theta_1))) * (x - 0)' });
        calculator.setExpression({ id: 'radiusB', latex: 'y = (5 * sin(\\theta_2) / (5 * cos(\\theta_2))) * (x - 0)' });

        // Add sliders to dynamically adjust the positions of points A and B
        calculator.setExpression({ id: 'sliderTheta1', latex: '\\theta_1 = 0', sliderBounds: { min: 0, max: 2 * Math.PI } });
        calculator.setExpression({ id: 'sliderTheta2', latex: '\\theta_2 = \\frac{\\pi}{3}', sliderBounds: { min: 0, max: 2 * Math.PI } });

