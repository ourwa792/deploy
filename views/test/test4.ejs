// ملف: dynamic_cone_surface.js
const board = JXG.JSXGraph.initBoard('jxgbox', {
    boundingbox: [-6, 6, 6, -6],
    axis: true,
    showNavigation: false,
    zoom: false,
});

// نصف القطر للقطاع الجانبي
const sectorRadius = 4;

// إنشاء شريط تمرير للتحكم في زاوية القطاع
const slider = board.create('slider', [[-5, 5], [-2, 5], [0, Math.PI / 2, 2 * Math.PI]], {
    name: 'زاوية القطاع (راديان)',
    snapWidth: 0.01,
});

// مركز القطاع الجانبي
const centerSector = [-3,-3];

// النقاط التي تحدد القطاع الجانبي
const A = board.create('point', [
    () => centerSector[0] + sectorRadius * Math.cos(slider.Value()),
    () => centerSector[1] + sectorRadius * Math.sin(slider.Value())
], { visible: false });

const B = board.create('point', [
    () => centerSector[0] + sectorRadius * Math.cos(0),
    () => centerSector[1] + sectorRadius * Math.sin(0)
], { visible: false });

// رسم القطاع الجانبي
const sector = board.create('sector', [[...centerSector], B, A], {
    strokeColor: 'blue',
    fillOpacity: 0.3,
});

// حساب طول القوس ديناميكيًا
const arcLength = () => slider.Value() * sectorRadius;

// حساب نصف قطر دائرة القاعدة بحيث يطابق طول القوس
const baseRadius = () => arcLength() / (2 * Math.PI);

// رسم دائرة القاعدة
const baseCircle = board.create('circle', [[1, 0], baseRadius], {
    strokeColor: 'red',
    fillOpacity: 0.2,
});

// نصوص تعليمية
board.create('text', [-5.5, 4.5, () => {
    const length = arcLength();
    const radius = baseRadius();
    return `طول القوس = ${length.toFixed(2)}, نصف قطر القاعدة = ${radius.toFixed(2)}`;
}], { fontSize: 15 });

board.create('text', [-5.5, 3.5, () => {
    return Math.abs(arcLength() - 2 * Math.PI * baseRadius()) < 0.1
        ? '✅ طول القوس يطابق محيط القاعدة!'
        : '❌ هناك اختلاف بين طول القوس ومحيط القاعدة!';
}], { fontSize: 15 });








