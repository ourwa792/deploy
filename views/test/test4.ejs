 /*
مضلع مع قطعة مستقيمة مع دائرة
شغال

var points = []; // لتخزين النقاط للرسم
var polygonComponents = []; // لتخزين عناصر الرسم مثل النقاط والخطوط والدائرة
var drawingMode = 'polygon'; // الوضع الافتراضي هو رسم المضلع
var interactionMode = false; // وضع التفاعل الافتراضي مغلق

// دالة لإعادة تعيين النقاط الحالية للرسم
function resetDrawing() {
  points = [];
}

// دالة لإنشاء مضلع عندما يكتمل
function createPolygon() {
  if (points.length > 2) { // تأكد من وجود 3 نقاط على الأقل
    var polygon = brd.create('polygon', points, {
      borders: { strokeWidth: 3 },
      hasInnerPoints: true,
    });
    polygonComponents.push(polygon);
    resetDrawing();
  }
}

// دالة لإنشاء قطعة مستقيمة بين نقطتين
function createLineSegment() {
  if (points.length === 2) { // تأكد من وجود نقطتين فقط
    var lineSegment = brd.create('segment', [points[0], points[1]], {
      strokeWidth: 3,
    });
    polygonComponents.push(lineSegment);
    resetDrawing();
  }
}

// دالة لإنشاء دائرة
function createCircle() {
  if (points.length === 2) { // تأكد من وجود نقطتين: مركز ونقطة لتحديد نصف القطر
    var circle = brd.create('circle', [points[0], points[1]], {
      strokeWidth: 3,
    });
    polygonComponents.push(circle);
    resetDrawing();
  }
}

// دالة للتعامل مع النقر على اللوحة
function down(e) {
  if (interactionMode) return; // عند تفعيل وضع التفاعل، يتم تعطيل إضافة الأشكال الجديدة

  var coords = getMouseCoords(e);
  var newPoint = brd.create('point', [coords.usrCoords[1], coords.usrCoords[2]], {visible: true});
  points.push(newPoint);
  polygonComponents.push(newPoint);

  // تنفيذ الرسم بناءً على الوضع الحالي
  if (drawingMode === 'line' && points.length === 2) {
    createLineSegment(); // رسم القطعة المستقيمة إذا تم تحديد نقطتين
  } else if (drawingMode === 'polygon' && points.length > 2) {
    createPolygon(); // رسم المضلع عند تحديد أكثر من نقطتين
  } else if (drawingMode === 'circle' && points.length === 2) {
    createCircle(); // رسم الدائرة عند تحديد نقطتين
  }
}

// دالة للحصول على إحداثيات الفأرة
function getMouseCoords(e) {
  var cPos = brd.getCoordsTopLeftCorner(e),
      absPos = JXG.getPosition(e);

  var dx = absPos[0] - cPos[0];
  var dy = absPos[1] - cPos[1];

  return new JXG.Coords(JXG.COORDS_BY_SCREEN, [dx, dy], brd);
}

// تسجيل حدث النقر على اللوحة
brd.on('down', down);

// دالة لتبديل وضع التفاعل
function toggleInteractionMode() {
  interactionMode = !interactionMode;
  var modeText = interactionMode ? "Interaction Mode ON" : "Interaction Mode OFF";
  console.log(modeText); // يمكن استبدال هذا بأسلوب عرض ملائم للمستخدم
}

// زر لتبديل وضع التفاعل
document.getElementById('toggleInteractionBtn').addEventListener('click', toggleInteractionMode);

// دالة لإعادة تعيين اللوحة
function resetBoard() {
  while (polygonComponents.length > 0) {
    brd.removeObject(polygonComponents.pop());
  }

  points = [];
  polygonComponents = [];
  brd.update();
}

// دالة لتغيير وضع الرسم بين مضلع وقطعة مستقيمة ودائرة
function switchDrawingMode(mode) {
  drawingMode = mode;
}

// أزرار لتغيير وضع الرسم
document.getElementById('polygonModeBtn').addEventListener('click', function() {
  switchDrawingMode('polygon');
});

document.getElementById('lineModeBtn').addEventListener('click', function() {
  switchDrawingMode('line');
});

document.getElementById('circleModeBtn').addEventListener('click', function() {
  switchDrawingMode('circle');
});

// زر إعادة تعيين اللوحة
document.getElementById('resetBoardBtn').addEventListener('click', resetBoard);

