// إنشاء الأجزاء المكونة للمعادلة
const parts = [
    new Label({ text: "2", size: 50, color: "white", backgroundColor: "red" }),
    new Label({ text: "+", size: 50, color: "white", backgroundColor: "green" }),
    new Label({ text: "3", size: 50, color: "white", backgroundColor: "blue" }),
    new Label({ text: "*", size: 50, color: "white", backgroundColor: "orange" }),
    new Label({ text: "5", size: 50, color: "white", backgroundColor: "purple" }),
];

// إنشاء الشبكة
const tile = new Tile({
    obj: parts, // الأجزاء المكونة للمعادلة
    cols: 5, // عدد الأعمدة
    rows: 1, // صف واحد فقط
    spacingH: 20,
}).center(stage);

// ترتيب المعادلة الصحيح
const correctOrder = ["2", "+", "3", "*", "5"];

// Scrambler مع التفاعل
const scrambler = new Scrambler(tile, {
    keys: correctOrder, // الترتيب الصحيح
    keyProperty: "text", // الخاصية المستخدمة للمطابقة
    scramble: true, // خلط الأجزاء
    time: 1, // مدة الخلط
}).center(stage);

// إضافة رسالة عند إكمال الترتيب بشكل صحيح
scrambler.on("complete", () => {
    new Pane({
        label: "رائع! لقد أتممت التمرين 🎉",
        width: 400,
        height: 200,
        color: "green",
        draggable: true,
    }).show();
});

// إضافة زر "تحقق من الحل"
const checkButton = new Button({
    label: "تحقق",
    width: 150,
    height: 50,
    backgroundColor: "blue",
    rollBackgroundColor: "darkblue",
}).pos(500, 500).addTo(stage);

// التحقق من النتيجة
checkButton.on("click", () => {
    if (scrambler.test()) {
        alert("الترتيب صحيح! 🎉");
    } else {
        alert("حاول مرة أخرى. 😕");
    }
});


