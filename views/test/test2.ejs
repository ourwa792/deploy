// إنشاء لوحة
var board = JXG.JSXGraph.initBoard('jxgbox', {boundingbox: [-5, 5, 5, -5], axis: true});

// إنشاء مثلث قابل للتحويل
var p1 = board.create('point', [1, 1], {name: 'A', size: 2});
var p2 = board.create('point', [3, 1], {name: 'B', size: 2});
var p3 = board.create('point', [2, 3], {name: 'C', size: 2});
var O = board.create('point', [0, 0], {name: 'O', size: 2});
var triangle = board.create('polygon', [p1, p2, p3], {borders: {strokeColor: 'blue'}});

// إضافة شريط تمرير للتحكم بزوايا الدوران
let rotationSlider = board.create('slider', [[-4, -4], [4, -4], [0,1,3]], {
    name: 'زاوية الدوران',
    snapWidth: 1
});

let rotationTransform = board.create('transform', [function(){
    return rotationSlider.Value() 
}, 0],{ type: 'translate' });

// Apply the rotation to the triangle (this can be applied on drag or any other event)
rotationTransform.bindTo([p1,p2,p3]);



